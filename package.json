{
  "name": "SalesfOps",
  "version": "0.3.4",
  "description": "A collection of productivity micro-tools for operations teams, with a focus on Salesforce workflows",
  "keywords": [
    "salesforce",
    "productivity",
    "automation",
    "utilities",
    "operations",
    "productivity-tools",
    "salesforce-tools",
    "id-lookup",
    "search-tools",
    "data-extraction",
    "json-tools",
    "batch-processing",
    "keyboard-shortcuts",
    "dev-tools",
    "ops-tools",
    "business-tools"
  ],
  "main": "main.js",
  "author": "Clément Beudot",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "setup-and-build": "npm install && npm run dist",
    "dist": "electron-builder",
    "test": "jest"
  },
  "jest": {
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.3.0"
  },
  "build": {
    "appId": "com.example.SalesfOps",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/csv-parse/**/*"
    ],
    "productName": "SalesfOps",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "assets/**/*",
      "src/**/*",
      "docs/*",
      "node_modules/**/*"
    ],
    "afterSign": "scripts/adhoc-sign.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0"
  },
  "homepage": "https://github.com/Clement-Beudot/SalesfOps#readme"
}
